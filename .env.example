# 로컬 개발용 — Firebase 인증을 우회하고 자동으로 superadmin으로 로그인
# (UI 디자인 검토용. 프로덕션에서는 절대 사용 금지)
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Firebase (필수) — Firebase Console > 프로젝트 설정 > 일반 > 웹 앱
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 슈퍼 관리자 이메일 (해당 이메일로 로그인하면 자동 superadmin 권한)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=withcomai@gmail.com

# 런모아 쇼핑플랫폼 — 갑이 런모아 측에서 발급받아 제공
NEXT_PUBLIC_RUNMOA_API_KEY=
NEXT_PUBLIC_RUNMOA_BASE_URL=https://aish.runmoa.com

# Google Sheets 자동 저장 (서버 전용)
GOOGLE_SHEETS_INQUIRY_SHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=

# 관리자 알림 이메일 (문의/버그 신고 시 발송)
ADMIN_NOTIFY_EMAIL=withcom7@naver.com

# Gemini AI (서버 전용 — 프롬프트/SEO/답변 초안/페이지 생성)
GEMINI_API_KEY=

# 답변 메일 발송 (Gmail SMTP — 2단계 인증 후 앱 비밀번호 발급)
SMTP_USER=
SMTP_APP_PASSWORD=

# GitHub Issue 자동 생성 (Phase 4)
GITHUB_TOKEN=
GITHUB_REPO=

# 발행 예약 cron 보호용 (선택)
CRON_SECRET=
