name: Build and Deploy (Firebase Hosting · static)

# main 에 push 하면 정적 빌드(out/) 후 Firebase Hosting(무료)에 자동 배포한다.
# 필요한 GitHub Secret (1개): FIREBASE_SERVICE_ACCOUNT
#   Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → JSON 전체를 시크릿 값으로.
# NEXT_PUBLIC_* 는 브라우저에 노출되는 공개 키라서 여기에 직접 둔다(비밀 아님).

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build_and_deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Type check
        run: npm run typecheck

      - name: Build (static export → out/)
        env:
          NEXT_PUBLIC_FIREBASE_API_KEY: AIzaSyAqfNSNWx3AtLqUwoBRfNu3EcfqO2ZT77Y
          NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: withcomai-web.firebaseapp.com
          NEXT_PUBLIC_FIREBASE_PROJECT_ID: withcomai-web
          NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET: withcomai-web.firebasestorage.app
          NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID: "345857326079"
          NEXT_PUBLIC_FIREBASE_APP_ID: 1:345857326079:web:0ed48cf03928076b2645ca
          NEXT_PUBLIC_SUPER_ADMIN_EMAIL: withcomai@gmail.com
          NEXT_PUBLIC_RUNMOA_BASE_URL: https://aish.runmoa.com
        run: npm run build

      - name: Deploy to Firebase Hosting (live)
        uses: FirebaseExtended/action-hosting-deploy@v0
        with:
          repoToken: ${{ secrets.GITHUB_TOKEN }}
          firebaseServiceAccount: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          projectId: withcomai-web
          channelId: live
