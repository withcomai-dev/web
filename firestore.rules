rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole(request.auth.uid) in ['admin', 'superadmin'];
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── 사용자 ──
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'user';
      allow update: if (isSelf(uid)
                       && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                       && !('status' in request.resource.data.diff(resource.data).affectedKeys()))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── 외부 서비스 키 (서버 전용) ──
    // 클라이언트 SDK 접근 완전 차단 — Admin SDK(서버)에서만 읽기/쓰기.
    // 어드민 UI는 /api/admin/integrations 라우트로 우회 호출.
    match /siteSettings/integrations {
      allow read, write: if false;
    }

    // ── 사이트 설정 (페이지 섹션, 전역 설정) ──
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 블로그형 콘텐츠 ──
    match /contents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 중소기업 지원사업 ──
    match /smeSupport/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 도움말 글 ──
    match /helpDocs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 도움말 위젯 질문 ──
    match /helpQuestions/{id} {
      allow create: if request.resource.data.question is string
                    && request.resource.data.question.size() > 0
                    && request.resource.data.question.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // ── 배너 ──
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 문의 ──
    match /inquiries/{id} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 10000;
      allow read, update, delete: if isAdmin();
    }

    // ── 활동 로그 (audit) ──
    match /auditLogs/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── AI 사용량 로그 ──
    match /aiUsageLogs/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── 페이지 버전 이력 ──
    match /siteSettings/{docId}/versions/{ts} {
      allow read, write: if isAdmin();
    }

    // ── 알림 큐 ──
    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    // ── 런모아 로그인 회원 ──
    // 쓰기는 서버 Admin SDK 전용(/auth/callback) — 클라이언트 쓰기 완전 차단.
    // 관리자만 목록 조회 가능.
    match /runmoaMembers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── 버그/피드백 신고 ──
    match /feedbackReports/{id} {
      allow create: if request.resource.data.status == 'open'
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
