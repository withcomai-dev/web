#!/bin/bash
#
# post-commit hook: main 브랜치 커밋 후 백그라운드에서 프로덕션 배포
#
# - 커밋은 즉시 완료 (배포는 백그라운드)
# - 로그: /tmp/{{PROJECT_SLUG}}-deploy.log
#
# ⚠️ 안전 규칙: main 브랜치 커밋만 프로덕션 자동 배포.
#    dev/기타 브랜치 커밋은 절대 프로덕션 배포하지 않는다.
#
# 이 훅은 scripts/hooks/ 에 커밋된 단일 원천.
# 최초 1회 `bash scripts/install-hooks.sh` 실행 시 core.hooksPath 로 연결된다.

# ── 브랜치 가드 (최우선) ────────────────────────────────────────────
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" != "{{MAIN_BRANCH}}" ]; then
  echo "[post-commit] 브랜치: $CURRENT_BRANCH → 프로덕션 자동 배포 건너뜀 ({{MAIN_BRANCH}}만 허용)"
  exit 0
fi

# 파일 기반 스킵 (npm run deploy 같은 수동 배포 흐름에서 사용)
if [ -f "/tmp/{{PROJECT_SLUG}}-skip-deploy" ]; then
  echo "[post-commit] skip-deploy sentinel 감지 → 자동 배포 건너뜀"
  exit 0
fi

# 이미 배포 중이면 건너뜀
LOCK_FILE="/tmp/{{PROJECT_SLUG}}-deploy.lock"
if [ -f "$LOCK_FILE" ]; then
  LOCK_PID=$(cat "$LOCK_FILE" 2>/dev/null)
  if kill -0 "$LOCK_PID" 2>/dev/null; then
    echo "[post-commit] 이미 배포 진행 중 (PID: $LOCK_PID) → 건너뜀"
    exit 0
  fi
  rm -f "$LOCK_FILE"
fi

PROJECT_DIR="$(git rev-parse --show-toplevel)"
LOG_FILE="/tmp/{{PROJECT_SLUG}}-deploy.log"
COMMIT_MSG="$(git log --oneline -1)"

(
  echo $$ > "$LOCK_FILE"
  trap 'rm -f "$LOCK_FILE"' EXIT

  echo "===== 배포 시작: $(date) =====" > "$LOG_FILE"
  echo "커밋: $COMMIT_MSG" >> "$LOG_FILE"

  cd "$PROJECT_DIR"

  # {{DEPLOY_PROD_CMD}} 로 배포 (프로젝트 배포 명령으로 치환)
  {{DEPLOY_PROD_CMD}} >> "$LOG_FILE" 2>&1
  DEPLOY_EXIT=$?

  if [ $DEPLOY_EXIT -eq 0 ]; then
    echo "===== 배포 성공: $(date) =====" >> "$LOG_FILE"
    # (선택) 완료 알림: {{NOTIFY_CMD}} "✅ 배포 성공: $COMMIT_MSG"
  else
    echo "===== 배포 실패 (exit $DEPLOY_EXIT): $(date) =====" >> "$LOG_FILE"
    PREV_OK_SHA=$(git log --format="%h" --skip=1 -1 2>/dev/null)
    echo "롤백 후보 (직전 커밋): ${PREV_OK_SHA}" >> "$LOG_FILE"
    # (선택) 실패 알림: {{NOTIFY_CMD}} "❌ 배포 실패: $COMMIT_MSG — 롤백 후보 ${PREV_OK_SHA}"
  fi
) &

# 백그라운드 실행, 커밋은 즉시 완료
disown
